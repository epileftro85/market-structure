# Copy this file to .env and fill in your values: cp .env.example .env
# .env is git-ignored: never commit real keys. Variables exported in the shell override .env.

# --- Data provider: ibkr (default) | alpaca | mock -------------------------
DATA_PROVIDER=ibkr

# --- App -------------------------------------------------------------------
# Default UI language: es | en (each browser can still switch with ES/EN)
APP_LANG=es
# Local web server port (always bound to 127.0.0.1)
# PORT=3000
# 1 = regular trading hours only, 0 = include pre/post market
# USE_RTH=1

# --- IBKR (IB Gateway / TWS) -----------------------------------------------
# Gateway live 4001 / paper 4002 · TWS live 7496 / paper 7497
# IB_HOST=127.0.0.1
# IB_PORT=4001
# IB_CLIENT_ID=17

# --- Alpaca (market data only, read-only) ----------------------------------
# Keys from https://app.alpaca.markets → API Keys. Paper and live keys are different.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# 1 = paper keys (default), 0 = live keys
ALPACA_PAPER=1
# iex = free for every account · sip = all US exchanges (free plans: 15 min delayed)
ALPACA_FEED=iex
